## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.env

# Operating System
.DS_Store
Thumbs.db
*.swp

# Secrets & Environment (Critical for Security Compliance)
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# Node.js / JavaScript (Plugins & MCP Tools)
node_modules/
dist/
build/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python (Python-based MCP/Tooling)
__pycache__/
*.py[cod]
.venv/
env/
venv/
*.egg-info/

# IDE & Local Editor State
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.cursor/cache/
.cursor/indexing/
.cursor/workspaces/

# Testing & Artifacts
coverage/
*.log
.nyc_output/

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs
